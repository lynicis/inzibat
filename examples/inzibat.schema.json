{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inzibat Configuration",
  "description": "Schema for Inzibat configuration files",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of this schema"
    },
    "serverPort": {
      "type": "integer",
      "description": "Port the server listens on"
    },
    "healthCheckRoute": {
      "type": "boolean",
      "description": "Register GET /health returning 200"
    },
    "circuitBreaker": {
      "$ref": "#/definitions/circuitBreaker"
    },
    "routes": {
      "type": "array",
      "description": "Routes served by the mock server",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "path": {
            "type": "string",
            "description": "Path the route answers on, starting with /"
          },
          "requestTo": {
            "type": "object",
            "description": "Upstream request the route proxies to",
            "properties": {
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "body": {
                "type": "object",
                "description": "JSON body sent upstream"
              },
              "host": {
                "type": "string",
                "description": "Upstream host, including scheme"
              },
              "path": {
                "type": "string",
                "description": "Upstream path, starting with /"
              },
              "passWithRequestBody": {
                "type": "boolean",
                "description": "Forward the incoming body instead of the configured one"
              },
              "passWithRequestHeaders": {
                "type": "boolean",
                "description": "Forward the incoming headers, configured ones winning"
              },
              "inErrorReturn500": {
                "type": "boolean",
                "description": "Return an empty 500 instead of the upstream error text"
              },
              "circuitBreaker": {
                "$ref": "#/definitions/circuitBreaker"
              }
            },
            "additionalProperties": false
          },
          "fakeResponse": {
            "type": "object",
            "description": "Static response the route returns",
            "properties": {
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "body": {
                "type": "object",
                "description": "JSON body returned to the client"
              },
              "bodyString": {
                "type": "string",
                "description": "Raw body returned to the client"
              },
              "statusCode": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["method", "path"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "circuitBreaker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failureThreshold": {
          "type": "integer"
        },
        "minimumRequests": {
          "type": "integer"
        },
        "openTimeoutMs": {
          "type": "integer",
          "description": "Milliseconds the breaker stays open"
        },
        "halfOpenMaxRequests": {
          "type": "integer"
        },
        "successThreshold": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
